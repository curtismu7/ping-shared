# ping-shared settings. Copy to .env beside docker-compose.yml (mode 600, gitignored).
# Everything here is optional: with nothing set, only cimd-doc-server runs.

# --- PingGateway (minimal): the token check on /mcp. GATEWAY_ISSUER and GATEWAY_AUDIENCE are required to start it. ---
# The `iss` the access tokens carry, exactly.
# GATEWAY_ISSUER=https://issuer.example/as
# The `aud` the access tokens must carry.
# GATEWAY_AUDIENCE=https://mcp.example/
# Where to fetch the signing keys. Default: the jwks_uri in <issuer>/.well-known/openid-configuration.
# The gateway runs in a container: an issuer on your host is host.docker.internal, not localhost.
# GATEWAY_JWKS_URI=https://issuer.example/as/jwks
# Optional: a scope the token must carry.
# GATEWAY_REQUIRED_SCOPE=mcp:invoke
# Where /mcp is proxied. Default: mcp-resource-server-LAB on this machine.
# GATEWAY_BACKEND_URL=http://host.docker.internal:8081
# Host port (loopback only). Default 7809.
# PINGGATEWAY_HOST_PORT=7809

# --- PingFederate ---
# Licence file (never committed). Default: ~/.config/demo-kit/pingfederate.lic
# PF_LICENSE_FILE=/path/to/pingfederate.lic
# Image. Default pingidentity/pingfederate:13.1.3-latest
# PF_IMAGE=pingidentity/pingfederate:13.1.3-latest
# Accepting the image's terms is YOUR step: the wrapper asks you to type YES, or you set this to YES yourself.
# PF_ACCEPT_EULA=YES

# --- Optional: a PingFederate on the US SE cluster to probe instead of a local one (a /pf/heartbeat.ping URL) ---
# PING_SHARED_SE_PF_URL=
